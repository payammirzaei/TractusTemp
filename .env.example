# Required: read-only GitHub token used to fetch official Tractus-X repositories.
GITHUB_TOKEN=

# Required: externally reachable Qdrant endpoint for the temporary bootstrap run.
# Example: https://your-temporary-qdrant-domain.up.railway.app
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tractusmind_knowledge

# Keep these identical to TractusMind production.
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

# HP Z4 defaults: both RTX PRO 4500 GPUs.
GPU_DEVICE_IDS=0,1
GPU_PARALLEL=2
GPU_BATCH_SIZE=256
SPARSE_BATCH_SIZE=256

# Optional comma-separated subset. Empty = all enabled TractusMind sources.
SOURCE_IDS=

# Idempotent resume behavior.
SKIP_COMPLETED=true
FAIL_FAST=false

# GitHub provider tuning.
GITHUB_TIMEOUT_SECONDS=60
GITHUB_MAX_ATTEMPTS=6
