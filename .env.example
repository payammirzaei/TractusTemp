# Optional in the default local-git mode because Eclipse Tractus-X repositories are public.
# Keep a token configured if you want to switch LOCAL_GIT_BOOTSTRAP=false.
GITHUB_TOKEN=

# Temporary Qdrant endpoint reachable from the HP bootstrap host.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tractusmind_knowledge

# Reconcile successful GPU snapshots directly against the FastAPI backend.
TRACTUSMIND_API_URL=https://api-production-a2a57.up.railway.app
TRACTUSMIND_ADMIN_KEY=

# Keep these identical to TractusMind production.
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

# HP Z4 defaults: both RTX PRO 4500 GPUs.
GPU_DEVICE_IDS=0,1
GPU_PARALLEL=2
GPU_BATCH_SIZE=256
SPARSE_BATCH_SIZE=256

# Org-scale bootstrap: shallow-clone repositories once and reuse the host cache.
LOCAL_GIT_BOOTSTRAP=true
REPO_CACHE_DIR=/repo-cache
GIT_TIMEOUT_SECONDS=900

# Optional comma-separated subset. Empty = all enabled TractusMind sources.
SOURCE_IDS=

# Idempotent resume behavior. Existing six-source state bundles are skipped when
# their upstream commit has not changed, so the overnight run focuses on new repos.
SKIP_COMPLETED=true
FAIL_FAST=false

# Used only when LOCAL_GIT_BOOTSTRAP=false.
GITHUB_TIMEOUT_SECONDS=60
GITHUB_MAX_ATTEMPTS=6
